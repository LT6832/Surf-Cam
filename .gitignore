
# ==========================================
# Surf-Cam .gitignore
# ==========================================

# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
venv/
.venv/
env/
surf/

# Python packaging and testing
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE-specific local settings
.vscode/*
!.vscode/extensions.json
.idea/

# Temporary files and logs
*.log
*.tmp
*.bak
*.swp
*~

# Sensor calibration files
# Keep calibration scripts, but exclude
# device-specific calibration results.
**/imu_calibration.json
**/mag_calibration.json

# Generated range-testing results
telemetry_range_results*.csv

# Computer vision model weights
*.pt
*.pth
*.onnx
*.engine

# Generated videos and recordings
*.mp4
*.avi
*.mov
*.mkv

# Image/video processing cache
runs/
